<section class="card section">
    <button class="section-head" aria-expanded="@(Expanded ? "true" : "false")" @onclick="Toggle">
        <span class="plus">@(Expanded ? "−" : "+")</span>
        <span>@Title</span>
    </button>
    @if (Expanded)
    {
        <div class="section-body">@ChildContent</div>
    }
</section>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Content is rendered only while open, so a panel loads its data on first open (lazy loading).
    Task Toggle() => ExpandedChanged.InvokeAsync(!Expanded);
}

@implements IDisposable
@inject InventoryService Inventory
@inject InventoryState State
@inject BinService BinsService
@inject ToastService Toast

<div class="card form">
    <FormField Label="Barcode"><input @bind="barcode" placeholder="e.g. 5901234123457" /></FormField>
    <FormField Label="Quantity"><input type="number" min="1" @bind="quantity" /></FormField>

    @if (Mode == OpMode.Transfer)
    {
        <FormField Label="From bin">
            <select @bind="fromBin"><option value="">-- choose --</option>@foreach (var b in bins) {<option value="@b.Code">@b.Code</option>}</select>
        </FormField>
        <FormField Label="To bin">
            <select @bind="toBin"><option value="">-- choose --</option>@foreach (var b in bins) {<option value="@b.Code">@b.Code</option>}</select>
        </FormField>
    }
    @if (Mode == OpMode.WriteOff)
    {
        <FormField Label="Bin">
            <select @bind="fromBin"><option value="">-- choose --</option>@foreach (var b in bins) {<option value="@b.Code">@b.Code</option>}</select>
        </FormField>
        <FormField Label="Reason (damaged, expired, lost…)"><input @bind="reason" /></FormField>
    }

    <button class="btn" disabled="@busy" @onclick="Submit">@Mode</button>
</div>

@code {
    public enum OpMode { Receive, Ship, Transfer, WriteOff }

    [Parameter] public OpMode Mode { get; set; }
    [CascadingParameter(Name = "CurrentUser")] public SessionUser? User { get; set; }

    string? barcode, fromBin, toBin, reason;
    int quantity = 1;
    bool busy;
    List<BinView> bins = new();

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += Changed;     // bin list stays current when bins are added elsewhere
        bins = await BinsService.ListAsync();
    }

    void Changed() => InvokeAsync(async () => { bins = await BinsService.ListAsync(); StateHasChanged(); });
    public void Dispose() => State.OnChange -= Changed;

    async Task Submit()
    {
        if (User is null) return;
        busy = true;
        var result = Mode switch
        {
            OpMode.Receive => await Inventory.ReceiveAsync(User, barcode, quantity),
            OpMode.Ship => await Inventory.ShipAsync(User, barcode, quantity),
            OpMode.Transfer => await Inventory.TransferAsync(User, barcode, fromBin, toBin, quantity),
            _ => await Inventory.WriteOffAsync(User, barcode, fromBin, quantity, reason)
        };
        Toast.Show(result.IsOk ? result.Unwrap() : result.Message, !result.IsOk);
        if (result.IsOk) { barcode = null; quantity = 1; reason = null; }
        busy = false;
    }
}
